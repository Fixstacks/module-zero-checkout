    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Response of Controller\Cart\Update: re-renders the same zero.checkout.minicart
    block as the GET fragment (declared in Zero_Core's zero_checkout_minicart.xml).
-->
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <body>
        <block class="Magento\Framework\View\Element\Template" name="zero.checkout.minicart" cacheable="false"
               template="Zero_Core::checkout/minicart-content.phtml">
            <arguments>
                <argument name="viewModel" xsi:type="object">Zero\Core\ViewModel\MiniCart</argument>
            </arguments>
        </block>
    </body>
</layout>
