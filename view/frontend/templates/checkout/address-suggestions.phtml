 *
 * Address suggestions under the street field (Controller\Checkout\
 * AddressSuggest). Each is a button: picking it asks AddressLookup to fill
 * the address (fields, rates and totals come back as for a saved address).
 * Plain buttons in a list: Tab reaches them, Enter or a click picks one.
 * Empty output when there is nothing to suggest, so the container collapses.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$suggestions = (array) $block->getData('suggestions');
if (!$suggestions) {
    return;
}
$lookupUrl = $block->getUrl('zero/checkout/addresslookup');
?>
<ul class="menu menu-sm w-full rounded-box border border-base-300 bg-base-100 p-1 shadow-md mt-1"
    aria-label="<?= $escaper->escapeHtmlAttr(__('Address suggestions')) ?>">
    <?php foreach ($suggestions as $suggestion): ?>
        <li>
            <button type="button"
                    hx-get="<?= $escaper->escapeUrl($lookupUrl) ?>"
                    hx-vals="<?= $escaper->escapeHtmlAttr((string) json_encode(['lookup_id' => $suggestion['id']])) ?>"
                    hx-include="#firstname, #lastname, #company, #telephone, #email"
                    hx-target="#shipping-address-fields" hx-swap="outerHTML"
                    hx-sync="#shipping-methods:replace"
                    class="text-start"><?= $escaper->escapeHtml($suggestion['label']) ?></button>
        </li>
    <?php endforeach; ?>
</ul>
