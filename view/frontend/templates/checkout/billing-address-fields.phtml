 *
 * Billing address fields (#billing-fields), inline and as the BillingAddress
 * response. The picker is inside the fieldset, so it hides with it while
 * "Same as shipping" is checked.
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Checkout\ViewModel\Checkout\CheckoutPage $viewModel
 */
$viewModel = $block->getData('viewModel');
$billingAddress = $viewModel->getBillingAddress();
$savedAddresses = $viewModel->getSavedAddresses();
?>
<div id="billing-fields" class="grid-cols-1 sm:grid-cols-2 gap-4">
    <?php if (!empty($savedAddresses)) : ?>
        <div class="field sm:col-span-2">
            <label class="label" for="billing-saved-address-picker"><?= $escaper->escapeHtml(__('Use a saved address')) ?></label>
            <select id="billing-saved-address-picker" name="billing_saved_address_id"
                    hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/billingaddress')) ?>"
                    hx-trigger="change" hx-target="#billing-fields" hx-swap="outerHTML"
                    hx-include="this" hx-sync="#billing-fields:replace"
                    class="select select-bordered w-full">
                <option value=""><?= $escaper->escapeHtml(__('Enter a new address')) ?></option>
                <?php foreach ($savedAddresses as $savedAddress) : ?>
                    <option value="<?= (int) $savedAddress['id'] ?>">
                        <?= $escaper->escapeHtml($savedAddress['label']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
    <?php endif; ?>
    <div class="field">
        <label class="label" for="billing_firstname"><?= $escaper->escapeHtml(__('First Name')) ?></label>
        <input type="text" name="billing_firstname" autocomplete="billing given-name" id="billing_firstname"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getFirstname()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field">
        <label class="label" for="billing_lastname"><?= $escaper->escapeHtml(__('Last Name')) ?></label>
        <input type="text" name="billing_lastname" autocomplete="billing family-name" id="billing_lastname"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getLastname()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field sm:col-span-2">
        <label class="label" for="billing_street"><?= $escaper->escapeHtml(__('Street Address')) ?></label>
        <input type="text" name="billing_street" autocomplete="billing address-line1" id="billing_street"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getStreetLine(1)) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field">
        <label class="label" for="billing_city"><?= $escaper->escapeHtml(__('City')) ?></label>
        <input type="text" name="billing_city" autocomplete="billing address-level2" id="billing_city"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getCity()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field">
        <label class="label" for="billing_country_id"><?= $escaper->escapeHtml(__('Country')) ?></label>
        <select name="billing_country_id" autocomplete="billing country" id="billing_country_id"
                hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/regions', ['prefix' => 'billing'])) ?>"
                hx-trigger="change" hx-target="#billing-region-field" hx-swap="outerHTML"
                hx-include="this"
                class="select select-bordered w-full">
            <?php $selectedBillingCountry = $billingAddress->getCountryId() ?: $viewModel->getDefaultCountryId(); ?>
            <?php foreach ($viewModel->getCountries() as $countryId => $name) : ?>
                <option value="<?= $escaper->escapeHtmlAttr($countryId) ?>"
                    <?= $selectedBillingCountry === $countryId ? 'selected' : '' ?>>
                    <?= $escaper->escapeHtml($name) ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>
    <div id="billing-region-field" class="field">
        <label class="label" for="billing_region"><?= $escaper->escapeHtml(__('State/Province')) ?></label>
        <input type="text" name="billing_region" autocomplete="billing address-level1" id="billing_region"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getRegion()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field">
        <label class="label" for="billing_postcode"><?= $escaper->escapeHtml(__('ZIP/Postal Code')) ?></label>
        <input type="text" name="billing_postcode" autocomplete="billing postal-code" id="billing_postcode"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getPostcode()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field">
        <label class="label" for="billing_telephone"><?= $escaper->escapeHtml(__('Phone')) ?></label>
        <input type="tel" inputmode="tel" name="billing_telephone" autocomplete="billing tel" id="billing_telephone"
               value="<?= $escaper->escapeHtmlAttr((string) $billingAddress->getTelephone()) ?>"
               class="input input-bordered w-full" />
    </div>
</div>
