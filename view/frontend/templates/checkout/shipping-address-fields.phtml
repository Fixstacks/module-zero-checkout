 *
 * Shipping address fields (#shipping-address-fields), rendered inline and as the
 * Controller\Checkout\Address response. Reads the quote's shipping address
 * itself, so after a saved address is applied it simply re-renders.
 * Fields that affect rates hx-get zero/checkout/shippingmethods (see index.phtml
 * for the hx-sync rule).
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Checkout\ViewModel\Checkout\CheckoutPage $viewModel
 */
$viewModel = $block->getData('viewModel');
$address = $viewModel->getShippingAddress();
$autocomplete = $viewModel->isAddressAutocompleteEnabled();
?>
<div id="shipping-address-fields" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="field required">
        <label class="label" for="firstname"><?= $escaper->escapeHtml(__('First Name')) ?></label>
        <input type="text" name="firstname" autocomplete="shipping given-name" id="firstname" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getFirstname()) ?>"
               class="input input-bordered w-full" />
    </div>
    <div class="field required">
        <label class="label" for="lastname"><?= $escaper->escapeHtml(__('Last Name')) ?></label>
        <input type="text" name="lastname" autocomplete="shipping family-name" id="lastname" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getLastname()) ?>"
               class="input input-bordered w-full" />
    </div>
    <?php $companyField = $viewModel->getCompanyField(); ?>
    <?php if ($companyField !== '') : ?>
        <div class="field<?= $companyField === 'req' ? ' required' : '' ?>">
            <label class="label" for="company"><?= $escaper->escapeHtml(__('Company')) ?></label>
            <input type="text" name="company" autocomplete="shipping organization" id="company"
                   <?= $companyField === 'req' ? 'required' : '' ?>
                   value="<?= $escaper->escapeHtmlAttr((string) $address->getCompany()) ?>"
                   class="input input-bordered w-full" />
        </div>
    <?php endif; ?>
    <?php if ($viewModel->isVatFieldShown()) : ?>
        <?php
        /*
         * VAT number (B2B in the EU): checked in VIES as it changes (#vat-check,
         * Controller\Checkout\Vat); rates and totals reload too, since a valid
         * number from another EU country can move the customer to Magento's
         * Intra-EU group (Customer Configuration > Create New Account Options).
         */
        $vatId = (string) $address->getVatId();
        ?>
        <div class="field">
            <label class="label" for="vat_id"><?= $escaper->escapeHtml(__('VAT Number')) ?></label>
            <input type="text" name="vat_id" id="vat_id" autocomplete="off" spellcheck="false"
                   value="<?= $escaper->escapeHtmlAttr($vatId) ?>" aria-describedby="vat-check"
                   hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
                   hx-trigger="change" hx-target="#shipping-methods" hx-swap="outerHTML"
                   hx-include="closest form" hx-sync="#shipping-methods:replace"
                   class="input input-bordered w-full" />
            <div id="vat-check" class="text-label mt-1" aria-live="polite"
                 hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/vat')) ?>"
                 hx-trigger="change from:#vat_id, change from:#country_id<?= $vatId !== '' ? ', load' : '' ?>"
                 hx-include="#vat_id, #country_id" hx-target="this" hx-swap="innerHTML"></div>
        </div>
    <?php endif; ?>
    <div class="field required sm:col-span-2">
        <label class="label" for="street"><?= $escaper->escapeHtml(__('Street Address')) ?></label>
        <input type="text" name="street" autocomplete="shipping address-line1" id="street" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getStreetLine(1)) ?>"
               hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
               hx-trigger="change" hx-target="#shipping-methods" hx-swap="outerHTML"
               hx-include="closest form" hx-sync="#shipping-methods:replace"
               <?= $autocomplete ? 'aria-describedby="address-suggestions-hint" aria-controls="address-suggestions"' : '' ?>
               class="input input-bordered w-full" />
        <?php if ($autocomplete) : ?>
            <p id="address-suggestions-hint" class="sr-only"><?= $escaper->escapeHtml(__('Suggestions appear below as you type; press Tab to reach them.')) ?></p>
            <div id="address-suggestions" aria-live="polite"
                 hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/addresssuggest')) ?>"
                 hx-trigger="input changed delay:350ms from:#street"
                 hx-include="#street, #country_id" hx-target="this" hx-swap="innerHTML"></div>
        <?php endif; ?>
    </div>
    <div class="field required">
        <label class="label" for="city"><?= $escaper->escapeHtml(__('City')) ?></label>
        <input type="text" name="city" autocomplete="shipping address-level2" id="city" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getCity()) ?>"
               hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
               hx-trigger="change" hx-target="#shipping-methods" hx-swap="outerHTML"
               hx-include="closest form" hx-sync="#shipping-methods:replace"
               class="input input-bordered w-full" />
    </div>
    <div class="field required">
        <label class="label" for="country_id"><?= $escaper->escapeHtml(__('Country')) ?></label>
        <select name="country_id" autocomplete="shipping country" id="country_id" required
                hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/regions')) ?>"
                hx-trigger="change" hx-target="#region-field" hx-swap="outerHTML"
                hx-include="this"
                class="select select-bordered w-full">
            <?php $selectedCountry = $address->getCountryId() ?: $viewModel->getDefaultCountryId(); ?>
            <?php foreach ($viewModel->getCountries() as $countryId => $name) : ?>
                <option value="<?= $escaper->escapeHtmlAttr($countryId) ?>"
                    <?= $selectedCountry === $countryId ? 'selected' : '' ?>>
                    <?= $escaper->escapeHtml($name) ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>
    <?php
    $regions = $viewModel->getRegionsForCurrentCountry();
    $selectedRegionId = $address->getRegionId();
    ?>
    <div id="region-field" class="field">
        <label class="label" for="region_id"><?= $escaper->escapeHtml(__('State/Province')) ?></label>
        <?php if (!empty($regions)) : ?>
            <select name="region_id" autocomplete="shipping address-level1" id="region_id"
                    hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
                    hx-trigger="zero:session-ready from:body, change" hx-target="#shipping-methods" hx-swap="outerHTML"
                    hx-include="closest form" hx-sync="#shipping-methods:replace"
                    class="select select-bordered w-full">
                <option value=""><?= $escaper->escapeHtml(__('Please select a region')) ?></option>
                <?php foreach ($regions as $regionId => $name) : ?>
                    <option value="<?= $escaper->escapeHtmlAttr((string) $regionId) ?>"
                        <?= (int) $selectedRegionId === (int) $regionId ? 'selected' : '' ?>>
                        <?= $escaper->escapeHtml($name) ?>
                    </option>
                <?php endforeach; ?>
            </select>
        <?php else : ?>
            <input type="text" name="region" autocomplete="shipping address-level1" id="region_id"
                   value="<?= $escaper->escapeHtmlAttr((string) $address->getRegion()) ?>"
                   hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
                   hx-trigger="zero:session-ready from:body, change" hx-target="#shipping-methods" hx-swap="outerHTML"
                   hx-include="closest form" hx-sync="#shipping-methods:replace"
                   class="input input-bordered w-full" />
        <?php endif; ?>
    </div>
    <div class="field required">
        <label class="label" for="postcode"><?= $escaper->escapeHtml(__('ZIP/Postal Code')) ?></label>
        <input type="text" name="postcode" autocomplete="shipping postal-code" id="postcode" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getPostcode()) ?>"
               hx-get="<?= $escaper->escapeUrl($block->getUrl('zero/checkout/shippingmethods')) ?>"
               hx-trigger="change" hx-target="#shipping-methods" hx-swap="outerHTML"
               hx-include="closest form" hx-sync="#shipping-methods:replace"
               class="input input-bordered w-full" />
    </div>
    <div class="field required">
        <label class="label" for="telephone"><?= $escaper->escapeHtml(__('Phone')) ?></label>
        <input type="tel" inputmode="tel" name="telephone" autocomplete="shipping tel" id="telephone" required
               value="<?= $escaper->escapeHtmlAttr((string) $address->getTelephone()) ?>"
               class="input input-bordered w-full" />
    </div>
</div>
